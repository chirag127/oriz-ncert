---
/*
 * /[class]/[subject]/[lang] — book page. The PUBLIC download is a plain Astro
 * link (never gated). A SaveBook Clerk+Firestore island optionally lets a
 * signed-in reader keep the book on their shelf.
 */
import SaveBook from '~/components/SaveBook.tsx'
import BaseLayout from '~/layouts/BaseLayout.astro'
import type { NcertEntry } from '~/lib/catalog'
import { classLabel, langLabel, loadCatalog, subjectLabel } from '~/lib/catalog'

export function getStaticPaths() {
  return loadCatalog().map((b) => ({
    params: { class: b.class, subject: b.subject, lang: b.lang },
    props: { book: b },
  }))
}

interface Props { book: NcertEntry }
const { book } = Astro.props as Props
const title = `${book.title} — oriz · ncert`
const description = `Download ${book.title} (${classLabel(book.class)} · ${subjectLabel(book.subject)} · ${langLabel(book.lang)}) as one merged NCERT PDF.`
const bookKey = `${book.class}/${book.subject}/${book.lang}`

const DISC: Record<string, string> = {
  math: 'maths', science: 'science', physics: 'science', chemistry: 'science', biology: 'science', evs: 'science',
  english: 'lang', hindi: 'lang', rimjhim: 'early',
}
const disc = DISC[book.subject] ?? 'social'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: book.title,
  bookFormat: 'https://schema.org/EBook',
  inLanguage: book.lang,
  description,
  url: book.pdf_url,
  publisher: { '@type': 'Organization', name: 'NCERT' },
}
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="spine book" data-disc={disc}>
    <header class="page-head">
      <p class="eyebrow">
        <a href="/">NCERT</a> /
        <a href={`/${book.class}/`}>{classLabel(book.class)}</a> /
        {subjectLabel(book.subject)}
      </p>
      <h1>{book.title}</h1>
    </header>

    <div class="book-grid">
      <div class="book-spine" aria-hidden="true">
        <span class="bs-head"></span>
        <span class="bs-label">{subjectLabel(book.subject)}</span>
        <span class="bs-call">{book.class === 'pre-primary' ? 'PP' : book.class}</span>
      </div>

      <div class="book-main">
        <dl class="book-meta">
          <div><dt>Class</dt><dd>{classLabel(book.class)}</dd></div>
          <div><dt>Subject</dt><dd>{subjectLabel(book.subject)}</dd></div>
          <div><dt>Language</dt><dd lang={book.lang}>{langLabel(book.lang)}</dd></div>
        </dl>

        <div class="book-actions">
          <a class="dl-btn" href={book.pdf_url} target="_blank" rel="noopener noreferrer">Download PDF</a>
          <SaveBook client:load bookKey={bookKey} title={book.title} />
        </div>

        <p class="book-note mono">
          Merged whole-book PDF on GitHub Releases. Source chapters © NCERT, from ncert.nic.in.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .book { --disc: var(--spine-social); padding-bottom: 4rem; }
  .book[data-disc='maths'] { --disc: var(--spine-maths); }
  .book[data-disc='science'] { --disc: var(--spine-science); }
  .book[data-disc='lang'] { --disc: var(--spine-lang); }
  .book[data-disc='early'] { --disc: var(--spine-early); }

  .book-grid {
    display: grid; grid-template-columns: 96px 1fr; gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-top: 2rem; align-items: start;
  }
  .book-spine {
    position: relative; height: 300px; border-radius: 3px 3px 0 0;
    background: var(--disc);
    background-image: linear-gradient(90deg, rgba(255,255,255,.16), transparent 22%, transparent 78%, rgba(0,0,0,.22));
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.12), 4px 4px 12px color-mix(in oklab, var(--ink) 18%, transparent);
  }
  .bs-head { position: absolute; left: 0; right: 0; top: 16px; height: 6px; background: repeating-linear-gradient(90deg, var(--shelf) 0 3px, #fff8 3px 6px); }
  .bs-label {
    position: absolute; inset: 44px 0 44px 0; display: flex; align-items: center; justify-content: center;
    writing-mode: vertical-rl; transform: rotate(180deg);
    font-family: var(--font-mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase;
    color: #fff; text-shadow: 0 1px 1px rgba(0,0,0,.35);
  }
  .bs-call {
    position: absolute; left: 10px; right: 10px; bottom: 12px; height: 26px;
    display: flex; align-items: center; justify-content: center;
    background: var(--paper); color: var(--ink);
    font-family: var(--font-mono); font-size: 13px; font-weight: 500; border-radius: 1px;
  }

  .book-meta { display: flex; flex-wrap: wrap; gap: 1.75rem; margin: 0 0 1.75rem; padding: 0; }
  .book-meta > div { display: flex; flex-direction: column; }
  .book-meta dt { font-family: var(--font-mono); font-size: .64rem; letter-spacing: .14em; text-transform: uppercase; color: var(--mist); }
  .book-meta dd { margin: .2rem 0 0; font-family: var(--font-display); font-size: 1.1rem; }

  .book-actions { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
  .dl-btn {
    display: inline-flex; align-items: center;
    padding: .8rem 1.75rem;
    background: var(--ochre); color: var(--board); border: 1px solid var(--ochre);
    font-family: var(--font-mono); font-size: .8rem; letter-spacing: .1em; text-transform: uppercase;
    font-weight: 500; text-decoration: none; transition: background .12s;
  }
  .dl-btn:hover { background: var(--ochre-deep); }
  .book-note { margin-top: 1.25rem; font-size: .8rem; color: var(--mist); max-width: 52ch; }

  @media (max-width: 560px) {
    .book-grid { grid-template-columns: 1fr; }
    .book-spine { width: 96px; }
  }
</style>
