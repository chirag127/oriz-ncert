---
/*
 * /[class]/ — the shelf for one class. Subject cards, coloured by discipline,
 * each opening the book download page.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import { CLASSES, classLabel, langLabel, loadCatalog, subjectLabel } from '~/lib/catalog'

export function getStaticPaths() {
  return CLASSES.map((cls) => ({ params: { class: cls } }))
}

const { class: cls } = Astro.params
const entries = loadCatalog().filter((b) => b.class === cls)
const label = classLabel(cls as string)
const title = `${label} — oriz · ncert`

const DISC: Record<string, string> = {
  math: 'maths', science: 'science', physics: 'science', chemistry: 'science', biology: 'science', evs: 'science',
  english: 'lang', hindi: 'lang', rimjhim: 'early',
}
const disc = (s: string) => DISC[s] ?? 'social'
---

<BaseLayout title={title} description={`NCERT textbooks for ${label} — one merged PDF each.`}>
  <div class="spine">
    <header class="page-head">
      <p class="eyebrow"><a href="/">NCERT</a> / {label}</p>
      <h1>{label}</h1>
      <p class="lede">Pick a subject. Each book opens as a single PDF.</p>
    </header>

    {entries.length === 0 ? (
      <p class="empty">No books shelved for this class yet. <a href="/browse/">Browse everything →</a></p>
    ) : (
      <ul class="subj-grid">
        {entries.map((b) => (
          <li class="subj-card" data-disc={disc(b.subject)}>
            <a href={`/${b.class}/${b.subject}/${b.lang}/`}>
              <span class="sc-band" aria-hidden="true"></span>
              <span class="sc-subject">{subjectLabel(b.subject)}</span>
              <span class="sc-title">{b.title}</span>
              <span class="sc-lang mono">{langLabel(b.lang)}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .subj-grid {
    list-style: none; padding: 0; margin: 1.75rem 0 3rem;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px;
  }
  .subj-card a {
    position: relative; display: flex; flex-direction: column; gap: .35rem;
    padding: 1.1rem 1rem 1rem 1.25rem;
    background: var(--paper-2); border: 1px solid var(--rule-line);
    text-decoration: none; color: var(--ink); min-height: 118px;
    transition: border-color .12s, transform .12s;
  }
  .subj-card a:hover { border-color: var(--blue); transform: translateY(-2px); }
  .sc-band { position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background: var(--spine-social); }
  .subj-card[data-disc='maths'] .sc-band { background: var(--spine-maths); }
  .subj-card[data-disc='science'] .sc-band { background: var(--spine-science); }
  .subj-card[data-disc='lang'] .sc-band { background: var(--spine-lang); }
  .subj-card[data-disc='early'] .sc-band { background: var(--spine-early); }
  .sc-subject { font-family: var(--font-display); font-size: 1.2rem; font-weight: 500; font-variation-settings: 'opsz' 40; }
  .sc-title { font-size: .95rem; color: var(--mist); line-height: 1.35; }
  .sc-lang { margin-top: auto; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--blue); }
  .empty { padding: 2rem 0; color: var(--mist); }
  .empty a { color: var(--blue); }
</style>
