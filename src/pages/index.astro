---
/*
 * Home — the Board. Hero thesis = a school blackboard on which the reader
 * chalks in Class → Subject → Language and opens the book. Signature element =
 * Board (Shelf.tsx). Everything around it stays quiet.
 */
import Board from '~/components/Shelf.tsx'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { CLASSES, classLabel, loadCatalog, subjectLabel } from '~/lib/catalog'
import { SITE_CONFIG } from '~/lib/siteConfig'

const catalog = loadCatalog()

const classLabelMap: Record<string, string> = {}
for (const c of CLASSES) classLabelMap[c] = classLabel(c)

const subjectLabelMap: Record<string, string> = {}
for (const e of catalog) if (!subjectLabelMap[e.subject]) subjectLabelMap[e.subject] = subjectLabel(e.subject)
for (const s of ['math', 'science', 'english', 'hindi', 'social-science', 'evs']) {
  if (!subjectLabelMap[s]) subjectLabelMap[s] = subjectLabel(s)
}

const bookCount = catalog.length
const classCount = new Set(catalog.map((e) => e.class)).size
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_CONFIG.name,
  url: SITE_CONFIG.origin,
  description: SITE_CONFIG.description,
  publisher: { '@type': 'Person', name: 'Chirag Singhal' },
}
---

<BaseLayout title={`${SITE_CONFIG.name} — ${SITE_CONFIG.tagline}`} description={SITE_CONFIG.description} jsonLd={jsonLd}>
  <div class="home spine">
    <header class="home-head">
      <p class="home-eyebrow">NCERT textbooks · Pre-K to Class XII · English &amp; हिंदी</p>
      <h1 class="home-title">Chalk in the book you need.</h1>
      <p class="home-lede">
        Every NCERT textbook, one whole-book PDF, keyed by class and subject.
        No install, no sign-in to read — pick below and it opens straight from
        the official chapter files.
      </p>
    </header>

    <Board
      client:load
      entries={catalog}
      classes={[...CLASSES]}
      classLabel={classLabelMap}
      subjectLabel={subjectLabelMap}
    />

    <dl class="home-stats" aria-label="At a glance">
      <div><dt>Books</dt><dd>{bookCount}</dd></div>
      <div><dt>Classes</dt><dd>{classCount}</dd></div>
      <div><dt>Cost</dt><dd>Free</dd></div>
    </dl>

    <p class="home-foot">
      Prefer a list? <a href="/browse/">Browse the whole catalogue</a> ·
      <a href="/search/">search by chapter</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .home { padding-block: clamp(1.75rem, 5vw, 3rem) 3rem; }
  .home-head { max-width: 60ch; }
  .home-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: .74rem; letter-spacing: .16em; text-transform: uppercase;
    color: var(--mist);
  }
  .home-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 6.5vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .home-title::after {
    content: ''; display: block; width: 2.6em; height: 3px; margin-top: .5rem;
    background: var(--ochre); border-radius: 2px; transform: rotate(-0.6deg);
  }
  .home-lede {
    margin: 1.1rem 0 0;
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--mist);
  }

  .home-stats {
    display: flex; flex-wrap: wrap; gap: 0 2.75rem; margin: 2.25rem 0 0; padding: 0;
  }
  .home-stats > div { display: flex; flex-direction: column; }
  .home-stats dt {
    font-family: var(--font-mono); font-size: .66rem; letter-spacing: .16em;
    text-transform: uppercase; color: var(--mist); order: 2;
  }
  .home-stats dd {
    margin: 0; font-family: var(--font-display); font-weight: 700;
    font-size: 1.9rem; line-height: 1; color: var(--ink); order: 1;
  }

  .home-foot {
    margin-top: 2.25rem;
    font-family: var(--font-mono);
    font-size: .82rem;
    letter-spacing: .02em;
    color: var(--mist);
  }
  .home-foot a { color: var(--sage); text-decoration: underline; text-underline-offset: 3px; }
  .home-foot a:hover { color: var(--ochre-deep); }
</style>
