---
/*
 * /browse — the full catalogue as a card-index: every book listed by class,
 * with a subject-coloured tab and a monospace call-number. Links to the book
 * download page. Quiet; the shelf on the home page carries the boldness.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import { classLabel, langLabel, loadCatalog, subjectLabel } from '~/lib/catalog'

const catalog = loadCatalog()
const order = (c: string) => (c === 'pre-primary' ? -1 : Number.parseInt(c, 10))
const classesInOrder = [...new Set(catalog.map((e) => e.class))].sort((a, b) => order(a) - order(b))

const DISC: Record<string, string> = {
  math: 'maths', science: 'science', physics: 'science', chemistry: 'science', biology: 'science', evs: 'science',
  english: 'lang', hindi: 'lang', rimjhim: 'early',
}
const disc = (s: string) => DISC[s] ?? 'social'
const total = catalog.length
---

<BaseLayout title="Browse — oriz · ncert" description="Every NCERT textbook in the reading room, listed by class.">
  <div class="spine">
    <header class="page-head">
      <p class="eyebrow"><a href="/">NCERT</a> / Catalogue</p>
      <h1>The whole catalogue.</h1>
      <p class="lede">{total} books, shelved by class. Each opens as one merged PDF.</p>
    </header>

    {classesInOrder.map((cls) => {
      const rows = catalog.filter((e) => e.class === cls)
      return (
        <section class="cat-class">
          <h2 class="cat-h">
            <a href={`/${cls}/`}>{classLabel(cls)}</a>
            <span class="cat-count mono">{rows.length}</span>
          </h2>
          <ul class="cat-list">
            {rows.map((e) => (
              <li class="cat-card" data-disc={disc(e.subject)}>
                <a href={`/${e.class}/${e.subject}/${e.lang}/`}>
                  <span class="cc-tab" aria-hidden="true"></span>
                  <span class="cc-body">
                    <span class="cc-title">{e.title}</span>
                    <span class="cc-meta mono">{subjectLabel(e.subject)} · {langLabel(e.lang)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    })}
  </div>
</BaseLayout>

<style>
  .cat-class { padding-block: 1.75rem; border-bottom: 1px solid var(--rule-line); }
  .cat-h {
    display: flex; align-items: baseline; gap: .75rem;
    margin: 0 0 1rem;
    font-family: var(--font-display); font-weight: 500; font-size: 1.5rem;
    font-variation-settings: 'opsz' 40;
  }
  .cat-h a { color: var(--ink); text-decoration: none; }
  .cat-h a:hover { color: var(--blue); }
  .cat-count { font-family: var(--font-mono); font-size: .8rem; color: var(--mist); }
  .cat-list {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 10px;
  }
  .cat-card a {
    display: flex; gap: .75rem; align-items: stretch;
    background: var(--paper-2); border: 1px solid var(--rule-line);
    text-decoration: none; color: var(--ink); min-height: 66px;
    transition: border-color .12s, transform .12s;
  }
  .cat-card a:hover { border-color: var(--blue); transform: translateX(2px); }
  .cc-tab { flex: 0 0 6px; background: var(--spine-social); }
  .cat-card[data-disc='maths'] .cc-tab { background: var(--spine-maths); }
  .cat-card[data-disc='science'] .cc-tab { background: var(--spine-science); }
  .cat-card[data-disc='lang'] .cc-tab { background: var(--spine-lang); }
  .cat-card[data-disc='early'] .cc-tab { background: var(--spine-early); }
  .cc-body { display: flex; flex-direction: column; justify-content: center; gap: .2rem; padding: .6rem .75rem .6rem 0; }
  .cc-title { font-family: var(--font-body); font-size: 1rem; line-height: 1.3; }
  .cc-meta { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; color: var(--mist); }
</style>
