---
/*
 * Footer — Register & Chalk. A class-timetable index: browse-by-class grid,
 * the catalogue links, and a source note. Signature detail: each column
 * heading carries a short ochre chalk-tick. Then the mandatory LegalFooter.
 */
import LegalFooter from '~/components/LegalFooter.astro'
import { CLASSES, classLabel } from '~/lib/catalog'

const classes = CLASSES.filter((c) => c !== 'pre-primary').map((c) => ({
  label: classLabel(c),
  href: `/${c}/`,
}))
const links = [
  { label: 'Browse everything', href: '/browse/' },
  { label: 'Search', href: '/search/' },
  { label: 'About this directory', href: '/about/' },
]
---
<footer class="footer" role="contentinfo">
  <div class="ft-grid spine">
    <div class="ft-col ft-col--wide">
      <h3 class="ft-h"><span class="ft-tag" aria-hidden="true"></span>Browse by class</h3>
      <ul class="ft-classes">
        {classes.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
      </ul>
    </div>
    <div class="ft-col">
      <h3 class="ft-h"><span class="ft-tag" aria-hidden="true"></span>The catalogue</h3>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div class="ft-col">
      <h3 class="ft-h"><span class="ft-tag" aria-hidden="true"></span>Where the books come from</h3>
      <p class="ft-note">
        Books link straight to <a href="https://ncert.nic.in/" rel="noopener external">ncert.nic.in</a>
        chapter files, merged into one PDF. We host no textbooks. NCERT material is © NCERT;
        this directory is a finding aid — free, no sign-in to read or download.
      </p>
    </div>
  </div>
  <LegalFooter
    appName="oriz · ncert"
    bio="Free NCERT textbooks — every class, every subject, one PDF each."
  />
</footer>
<style>
  .footer { margin-top: 4rem; background: var(--paper-2); border-top: 1px solid var(--rule-line); }
  .ft-grid {
    display: grid; grid-template-columns: 1fr; gap: 32px;
    padding-block: 44px 24px;
  }
  .ft-h {
    margin: 0 0 14px;
    font-family: var(--font-mono); font-size: .72rem; letter-spacing: .18em;
    text-transform: uppercase; color: var(--mist); font-weight: 400;
    display: flex; align-items: center; gap: 10px;
  }
  .ft-tag { display: inline-block; width: 26px; height: 3px; background: var(--ochre); border-radius: 2px; transform: rotate(-1deg); }
  .ft-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 7px; }
  .ft-col a { color: var(--ink); font-size: 1rem; text-decoration: none; }
  .ft-col a:hover { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
  .ft-classes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px 16px; }
  .ft-classes a { font-family: var(--font-mono); font-size: .9rem; }
  .ft-note { font-size: .95rem; line-height: 1.6; color: var(--mist); margin: 0; max-width: 42ch; }
  .ft-note a { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; }
  @media (min-width: 760px) {
    .ft-grid { grid-template-columns: 1.5fr 1fr 1.3fr; gap: 40px; padding-block: 52px 28px; }
  }
</style>
