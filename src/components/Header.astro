---
/*
 * Header — Register & Chalk chrome. A thin ruled strip on mineral paper:
 *   Left:   oriz.in wordmark (subtitle "ncert"), links to the oriz.in hub.
 *   Center: persistent catalogue search (paper field, sage underline).
 *   Right:  Clerk AccountButton island + a drawer toggle on small screens.
 * The whole header sits above a single sage baseline rule.
 */
import AccountButton from './AccountButton.tsx'
import Wordmark from './Wordmark.astro'
---

<header class="header">
  <div class="header-row spine">
    <a class="header-home" href="/" aria-label="ncert — home">
      <Wordmark subtitle="ncert" size={21} href={null} />
    </a>

    <form class="header-search" role="search" action="/search/" method="get">
      <label for="header-q" class="sr-only">Search the catalogue</label>
      <span class="hs-icon" aria-hidden="true">⌕</span>
      <input
        id="header-q"
        name="q"
        type="search"
        class="hs-input"
        placeholder="Find a book — class, subject, chapter…"
        autocomplete="off"
        data-cycle-placeholder
      />
    </form>

    <div class="header-right">
      <AccountButton client:load />
      <label class="header-toggle" for="sb-toggle" aria-label="Open class menu">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </label>
    </div>
  </div>
  <hr class="header-rule" />
</header>

<script is:inline>
  ;(() => {
    const P = [
      'Find a book — class, subject, chapter…',
      'कक्षा, विषय या अध्याय खोजें…',
      'Class 10 Science…',
      'कक्षा 8 गणित…',
    ]
    const els = document.querySelectorAll('[data-cycle-placeholder]')
    if (!els.length) return
    let i = 0, paused = false
    for (const el of els) {
      el.addEventListener('focus', () => { paused = true })
      el.addEventListener('blur', () => { paused = false })
    }
    setInterval(() => {
      if (paused) return
      i = (i + 1) % P.length
      for (const el of els) if (el !== document.activeElement) el.setAttribute('placeholder', P[i])
    }, 4000)
  })()
</script>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.1) blur(6px);
  }
  .header-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    height: 60px;
  }
  .header-home { display: inline-flex; align-items: center; text-decoration: none; }
  .header-search {
    display: flex; align-items: center; gap: .5rem;
    justify-self: center; width: 100%; max-width: 460px;
    border-bottom: 2px solid var(--blue);
    padding: .1rem .1rem .35rem;
  }
  .hs-icon { color: var(--mist); font-size: 1rem; }
  .hs-input {
    flex: 1; min-width: 0;
    background: transparent; border: 0; color: var(--ink);
    font-family: var(--font-body); font-size: .98rem;
  }
  .hs-input::placeholder { color: var(--mist); }
  .hs-input:focus { outline: none; }
  .header-search:focus-within { border-bottom-color: var(--marker); }

  .header-right { display: inline-flex; align-items: center; gap: .6rem; justify-self: end; }

  .header-toggle {
    display: none;
    flex-direction: column; gap: 4px;
    width: 34px; height: 34px; align-items: center; justify-content: center;
    border: 1px solid var(--rule-line); cursor: pointer;
  }
  .header-toggle span { display: block; width: 15px; height: 1.5px; background: var(--ink); }
  .header-toggle:hover { border-color: var(--blue); }
  .header-toggle:hover span { background: var(--blue); }

  .header-rule { height: 1px; background: var(--rule-line); border: 0; margin: 0; }

  @media (max-width: 860px) {
    .header-search { max-width: none; }
  }
  @media (max-width: 700px) {
    .header-toggle { display: inline-flex; }
    .header-row { grid-template-columns: auto 1fr auto; gap: .6rem; }
    .header-search { display: none; }
  }
</style>
