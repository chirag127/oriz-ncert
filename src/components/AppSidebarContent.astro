---
/*
 * AppSidebarContent — class navigation grouped by stage, plus quick subjects.
 * Links target the real routes: /{class}/ and /{class}/{subject}/{lang}/.
 */
const groups = [
  { label: 'Pre-primary', items: [{ href: '/pre-primary/', label: 'Pre-K' }] },
  { label: 'Primary · 1–5', items: [1, 2, 3, 4, 5].map((c) => ({ href: `/${c}/`, label: `Class ${c}` })) },
  { label: 'Middle & secondary · 6–10', items: [6, 7, 8, 9, 10].map((c) => ({ href: `/${c}/`, label: `Class ${c}` })) },
  { label: 'Senior secondary · 11–12', items: [11, 12].map((c) => ({ href: `/${c}/`, label: `Class ${c}` })) },
]
---
<nav aria-label="Classes">
  {groups.map((g) => (
    <section class="sb-group">
      <h3>{g.label}</h3>
      <ul>
        {g.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </section>
  ))}
  <section class="sb-group">
    <h3>Everything</h3>
    <ul>
      <li><a href="/browse/">Full catalogue</a></li>
      <li><a href="/search/">Search</a></li>
    </ul>
  </section>
</nav>
<style>
  .sb-group { margin-bottom: 18px; }
  .sb-group h3 {
    font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em;
    text-transform: uppercase; color: var(--mist); margin: 0 0 7px; font-weight: 400;
  }
  .sb-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .sb-group a {
    display: block; padding: 4px 8px; color: var(--ink); text-decoration: none;
    font-size: .95rem; border-left: 2px solid transparent;
  }
  .sb-group a:hover { border-left-color: var(--ochre); color: var(--sage); }
</style>
