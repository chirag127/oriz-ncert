---
/*
 * Wordmark — "oriz" set in the slab display face, drawn like chalk. A yellow
 * chalk-tick underscores the mark (the teacher's underline on the board).
 * Optional subtitle after an ochre middot. Links to https://oriz.in by default
 * (the oriz.in wordmark in chrome).
 */
interface Props {
  /** Sub-section name after an ochre middot. */
  subtitle?: string
  /** Display size in CSS pixels. */
  size?: number
  /** Link target. Defaults to the oriz.in hub; pass '/' for the home link. */
  href?: string | null
  /** Render on the dark board (chalk-white ink) instead of paper. */
  onBoard?: boolean
}
const { subtitle, size = 22, href = 'https://oriz.in', onBoard = false } = Astro.props
const external = href?.startsWith('http')
const cls = `wordmark${onBoard ? ' wordmark--board' : ''}`
---

{
  href ? (
    <a
      class="wordmark-link"
      href={href}
      aria-label={subtitle ? `oriz · ${subtitle}` : 'oriz.in'}
      {...(external ? { rel: 'noopener' } : {})}
    >
      <span class={cls} style={`--wm-size: ${size}px;`}>
        <span class="wm-mark">oriz<span class="wm-chalk" aria-hidden="true" /></span>
        {subtitle && (
          <>
            <span class="wm-sep" aria-hidden="true">·</span>
            <span class="wm-sub">{subtitle}</span>
          </>
        )}
      </span>
    </a>
  ) : (
    <span class={cls} style={`--wm-size: ${size}px;`}>
      <span class="wm-mark">oriz<span class="wm-chalk" aria-hidden="true" /></span>
      {subtitle && (
        <>
          <span class="wm-sep" aria-hidden="true">·</span>
          <span class="wm-sub">{subtitle}</span>
        </>
      )}
    </span>
  )
}

<style>
  .wordmark-link { display: inline-flex; color: inherit; text-decoration: none; }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--wm-size, 22px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .wordmark--board { color: var(--chalk); }
  .wm-mark { position: relative; }
  /* yellow chalk underline — a hand-drawn tick under the mark */
  .wm-chalk {
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    bottom: -0.14em;
    height: max(2px, 0.09em);
    background: var(--ochre);
    border-radius: 2px;
    transform: rotate(-0.8deg);
    pointer-events: none;
  }
  .wm-sep { color: var(--ochre); font-weight: 700; }
  .wm-sub {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.6em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .wordmark--board .wm-sub { color: var(--chalk-dim); }
  .wordmark-link:hover .wm-chalk { background: var(--sage); }
</style>
